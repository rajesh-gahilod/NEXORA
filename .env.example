# NEXORA AI — Environment Configuration
# Base URL for the Java Spring Boot Backend API
VITE_API_BASE_URL=http://localhost:8080/api

# App Environment: development | production | demo
VITE_APP_ENV=development

# Enable local simulated mock mode when backend is offline
VITE_ENABLE_MOCK_FALLBACK=true

# App Metadata
VITE_APP_NAME=NEXORA AI
VITE_APP_VERSION=2.4.0
